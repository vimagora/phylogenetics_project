# Downloaded genome data (large, re-download with scripts/download_mycocosm_genomes.sh)
01_genomes/*
!01_genomes/.gitkeep
*.part
*.log

# Windows download metadata
*:Zone.Identifier

# Decompressed proteomes (re-create with scripts/extract_proteomes.sh)
02_BUSCO/proteomes/

# BUSCO results and Slurm logs (re-create with scripts/run_busco.sbatch)
02_BUSCO/results/
02_BUSCO/logs/*
!02_BUSCO/logs/.gitkeep

# Collapsed proteomes and intermediate files (re-create with scripts/collapse_isoforms.sh)
04_isoforms/collapsed_proteomes/
04_isoforms/work/

# Python bytecode
__pycache__/
