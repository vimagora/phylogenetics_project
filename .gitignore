# Downloaded genome data (large, re-download with scripts/download_mycocosm_genomes.sh)
01_genomes/*
!01_genomes/.gitkeep
*.part
*.log

# Windows download metadata
*:Zone.Identifier

# Decompressed proteomes (re-create with scripts/extract_proteomes.sh)
04_BUSCO/proteomes/

# BUSCO results and Slurm logs (re-create with scripts/run_busco.sbatch)
04_BUSCO/results/
04_BUSCO/logs/*
!04_BUSCO/logs/.gitkeep

# Collapsed proteomes and intermediate files (re-create with scripts/collapse_isoforms.sh)
03_isoforms/collapsed_proteomes/
03_isoforms/work/

# Proteomes with clean IDs and their ID maps (re-create with scripts/clean_proteomes.py)
05_clean_proteomes/

# Python bytecode
__pycache__/

# Local settings (copy config.example.sh to config.sh)
config.sh
